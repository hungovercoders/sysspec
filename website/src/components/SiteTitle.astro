---
// Starlight `SiteTitle` override: the inline mark plus a typographic
// wordmark, so both follow the theme tokens (an <img> logo cannot).
import Mark from './Mark.astro';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="ss-site-title" translate="no">
  <Mark size={26} />
  <span class="ss-wordmark">{siteTitle}</span>
</a>

<style>
  .ss-site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ss-text);
  }
  .ss-wordmark {
    font-weight: 650;
    font-size: 1.125rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
</style>
