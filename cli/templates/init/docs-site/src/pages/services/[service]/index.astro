---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import SystemGraph from '../../../components/SystemGraph';
import {
  anchor,
  artifactPage,
  artifactUrl,
  channelHref,
  channelProducers,
  edges,
  KIND_LABELS,
  services,
  sortedArtifacts,
  unconsumed,
  withBase,
} from '../../../lib/specs';
import type { Artifact } from '../../../lib/specs';

export function getStaticPaths() {
  return services.map((s) => ({ params: { service: s.name }, props: { service: s } }));
}

const { service } = Astro.props;

const FORMATS: Record<Artifact['kind'], string> = {
  openapi: 'OpenAPI',
  asyncapi: 'AsyncAPI',
  'data-contract': 'ODCS',
  feature: 'Gherkin',
  doc: 'Markdown',
};

const cardTitle = (a: Artifact) => {
  if (a.kind === 'data-contract') return a.odcs?.name ?? KIND_LABELS[a.kind];
  if (a.kind === 'feature') return a.feature?.title ?? KIND_LABELS[a.kind];
  if (a.kind === 'doc') return a.label ?? a.summary ?? a.stem;
  return KIND_LABELS[a.kind];
};

const openapiPage = (() => {
  const a = service.artifacts.find((x) => x.kind === 'openapi');
  return a ? artifactPage(service.name, a) : null;
})();
const commands = service.operations.filter((o) => o.kind === 'command');
const queries = service.operations.filter((o) => o.kind === 'query');
const consumerLinks = (address: string) =>
  services.filter((s) => s.consumes.includes(address));

const hasSurface =
  service.produces.length > 0 ||
  service.consumes.length > 0 ||
  service.operations.length > 0 ||
  service.data_products.length > 0;
const graphServices = services.map((s) => ({
  name: s.name,
  title: s.title,
  domain: s.domain,
  version: s.version,
  operations: s.operations.map((o) => ({ op_id: o.op_id })),
  data_products: s.data_products,
}));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pin = service.latest_release;

// "On this page" entries, mirroring the conditional sections below.
const headings = [
  ...(hasSurface ? [{ depth: 2, slug: 'at-a-glance', text: 'At a glance' }] : []),
  { depth: 2, slug: 'artifacts', text: 'Artifacts' },
  { depth: 2, slug: 'drive-an-implementation', text: 'Drive an implementation' },
  ...(commands.length ? [{ depth: 2, slug: 'commands', text: 'Commands' }] : []),
  ...(queries.length ? [{ depth: 2, slug: 'queries', text: 'Queries' }] : []),
  ...(service.produces.length ? [{ depth: 2, slug: 'produces', text: 'Produces' }] : []),
  ...(service.consumes.length ? [{ depth: 2, slug: 'consumes', text: 'Consumes' }] : []),
  ...(service.data_products.length
    ? [{ depth: 2, slug: 'data-products', text: 'Data products' }]
    : []),
];
---
<StarlightPage
  frontmatter={{ title: service.title, description: service.summary }}
  headings={headings}
>
  <p class="sc-page-meta">
    <span class="sc-version">v{service.version ?? '—'}</span>
    <span class="sc-sep">·</span>
    <span>{service.domain}</span>
    <span class="sc-sep">·</span>
    <code>{service.owner}</code>
    {pin && !service.ahead && <span class="sc-chip sc-chip--ok">released {pin.tag}</span>}
    {service.ahead && <span class="sc-chip sc-chip--warn">spec ahead of release</span>}
    {service.implementation_repo && (
      <>
        <span class="sc-sep">·</span>
        <a href={`https://github.com/${service.implementation_repo}`}>{service.implementation_repo}</a>
      </>
    )}
  </p>
  <p class="sc-summary">{service.summary}</p>

  {service.ahead && (
    <p class="sc-notice">
      This spec is at <strong>&nbsp;v{service.version}&nbsp;</strong>, ahead of the last
      release{pin && <>&nbsp;(<code>{pin.tag}</code>)</>} — it is the surface the
      next implementation change converges on.
    </p>
  )}

  {hasSurface && (
    <>
      <h2 id="at-a-glance">At a glance</h2>
      <p class="sc-graph-hint">
        Click a node to trace its connections; double-click a service to open
        it.
      </p>
      <div class="sc-graph"><SystemGraph
        client:only="react"
        services={graphServices}
        edges={edges}
        unconsumed={unconsumed}
        base={base}
        focus={service.name}
        height={380}
      /></div>
    </>
  )}

  <h2 id="artifacts">Artifacts</h2>
  <div class="sc-artifacts">
    {sortedArtifacts(service).map((a) => (
      <div class={`sc-artifact-card sc-artifact-card--${a.kind}`}>
        <span class={`sc-kind-label sc-kind-label--${a.kind}`}>{FORMATS[a.kind]}</span>
        <h3><a href={artifactPage(service.name, a)}>{cardTitle(a)}</a></h3>
        <p>{a.summary}</p>
        <span class="sc-artifact-meta">
          {a.version && <span>v{a.version}</span>}
          <span class={a.gated ? 'sc-chip sc-chip--gated' : 'sc-chip'}>
            {a.gated ? 'gated' : 'context'}
          </span>
          <a class="sc-raw" href={artifactUrl(service.name, a)}>raw</a>
        </span>
      </div>
    ))}
  </div>

  <h2 id="drive-an-implementation">Drive an implementation</h2>
  <p>
    These specs are packaged for consumption — an implementation proves it
    satisfies them; it never redefines them.
    {service.implementation_repo && (
      <>
        {' '}Current implementation:{' '}
        <a href={`https://github.com/${service.implementation_repo}`}>
          {service.implementation_repo}
        </a>.
      </>
    )}
  </p>
  {pin ? (
    <>
      <p>
        Pin the released surface in a <code>contracts.lock</code> at the
        implementation repo's root and fetch it read-only:
      </p>
      <pre><code>{`# contract pin - version is the specs release tag, sha its commit
version: ${pin.tag}
sha: ${pin.sha}`}</code></pre>
      <p>
        The full loop — fetch, strict binding, verification, staying
        converged via Renovate — is on{' '}
        <a href={withBase('/implementing/')}>Drive an implementation</a>.
      </p>
    </>
  ) : (
    <p>
      No release tag yet — the first merge to main publishes
      <code> {service.name}/v{service.version}</code> for implementations to
      pin. The loop it feeds is on{' '}
      <a href={withBase('/implementing/')}>Drive an implementation</a>.
    </p>
  )}

  {commands.length > 0 && (
    <>
      <h2 id="commands">Commands</h2>
      <ul class="sc-rows">
        {commands.map((o) => (
          <li>
            <span class={`sc-method sc-method--${o.method.toLowerCase()}`}>{o.method}</span>
            {openapiPage ? (
              <a href={`${openapiPage}#${anchor(o.op_id)}`}>{o.op_id}</a>
            ) : (
              <strong>{o.op_id}</strong>
            )}
            <span class="sc-row-note"><code>{o.path}</code></span>
          </li>
        ))}
      </ul>
    </>
  )}
  {queries.length > 0 && (
    <>
      <h2 id="queries">Queries</h2>
      <ul class="sc-rows">
        {queries.map((o) => (
          <li>
            <span class={`sc-method sc-method--${o.method.toLowerCase()}`}>{o.method}</span>
            {openapiPage ? (
              <a href={`${openapiPage}#${anchor(o.op_id)}`}>{o.op_id}</a>
            ) : (
              <strong>{o.op_id}</strong>
            )}
            <span class="sc-row-note"><code>{o.path}</code></span>
          </li>
        ))}
      </ul>
    </>
  )}

  {service.produces.length > 0 && (
    <>
      <h2 id="produces">Produces</h2>
      <ul class="sc-rows">
        {service.produces.map((address) => {
          const consuming = consumerLinks(address);
          const href = channelHref(address);
          return (
            <li>
              {href ? (
                <a href={href}><code>{address}</code></a>
              ) : (
                <code>{address}</code>
              )}
              {consuming.length > 0 ? (
                <span class="sc-row-note">
                  consumed by{' '}
                  {consuming.map((c, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={withBase(`/services/${c.name}/`)}>{c.title}</a>
                    </>
                  ))}
                </span>
              ) : (
                <span class="sc-row-note">no consumer in the specs</span>
              )}
            </li>
          );
        })}
      </ul>
    </>
  )}
  {service.consumes.length > 0 && (
    <>
      <h2 id="consumes">Consumes</h2>
      <ul class="sc-rows">
        {service.consumes.map((address) => {
          const producer = channelProducers[address];
          return (
            <li>
              {producer ? (
                <>
                  <a href={channelHref(address)}>
                    <code>{address}</code>
                  </a>
                  <span class="sc-row-note">produced by{' '}
                  <a href={withBase(`/services/${producer.name}/`)}>{producer.title}</a></span>
                </>
              ) : (
                <code>{address}</code>
              )}
            </li>
          );
        })}
      </ul>
    </>
  )}

  {service.data_products.length > 0 && (
    <>
      <h2 id="data-products">Data products</h2>
      <ul class="sc-rows">
        {service.data_products.map((d) => (
          <li>
            <a href={withBase(`/services/${service.name}/${d.stem}/`)}>{d.title}</a>
          </li>
        ))}
      </ul>
    </>
  )}
</StarlightPage>
