---
import type { SchemaRow } from '../lib/specs';

interface Props {
  rows: SchemaRow[];
}
const { rows } = Astro.props;
---
{rows.length > 0 && (
  <div class="sc-table-wrap"><table class="sc-table">
    <thead>
      <tr><th>Field</th><th>Type</th><th>Required</th><th>Constraints</th></tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td><code>{r.field}</code></td>
          <td>{r.type}</td>
          <td>{r.required ? <span class="sc-req">required</span> : <span class="sc-opt">optional</span>}</td>
          <td>{r.constraints || '—'}</td>
        </tr>
      ))}
    </tbody>
  </table></div>
)}
