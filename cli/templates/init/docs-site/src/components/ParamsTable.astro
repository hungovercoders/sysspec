---
import type { Operation } from '../lib/specs';

interface Props {
  params: Operation['parameters'];
}
const { params } = Astro.props;
---
{params.length > 0 && (
  <div class="sc-table-wrap"><table class="sc-table">
    <thead>
      <tr><th>Parameter</th><th>In</th><th>Type</th><th>Required</th></tr>
    </thead>
    <tbody>
      {params.map((p) => (
        <tr>
          <td><code>{p.name}</code></td>
          <td>{p.in}</td>
          <td>{p.type}</td>
          <td>{p.required ? <span class="sc-req">required</span> : <span class="sc-opt">optional</span>}</td>
        </tr>
      ))}
    </tbody>
  </table></div>
)}
