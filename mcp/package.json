{
  "name": "sysspec-mcp",
  "version": "1.1.0",
  "description": "Read-only MCP access to versioned system specs: AsyncAPI, OpenAPI, ODCS data contracts and Gherkin acceptance criteria.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hungovercoders/sysspec.git",
    "directory": "mcp"
  },
  "type": "module",
  "bin": {
    "sysspec-mcp": "dist/stdio.mjs"
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/bundle-skills.mjs && tsup",
    "test": "vitest run",
    "typecheck": "node scripts/bundle-skills.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "yaml": "^2.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
